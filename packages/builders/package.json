{
  "name": "@fastwa/builders",
  "version": "2.0.0",
  "description": "Message builders for fastwa: stickers, contacts and text formatting",
  "keywords": [
    "fastwa",
    "whatsapp",
    "sticker",
    "vcard"
  ],
  "homepage": "https://fastwa.org",
  "bugs": {
    "url": "https://github.com/fastwa/fastwa/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fastwa/fastwa.git",
    "directory": "packages/builders"
  },
  "license": "MIT",
  "author": "Natan Rodrigues",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "**/*.js",
    "**/*.d.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "node-webpmux": "^3.1.3",
    "sharp": "^0.35.5",
    "tslib": "2.4.1"
  },
  "peerDependencies": {
    "@whiskeysockets/baileys": "^7.0.0-rc14"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
