{
  "name": "fastwa",
  "version": "1.1.0",
  "description": "Framework for building WhatsApp chatbots with modules, controllers and dependency injection",
  "keywords": [
    "fastwa",
    "whatsapp",
    "chatbot",
    "framework",
    "dependency-injection"
  ],
  "homepage": "https://fastwa.org",
  "bugs": {
    "url": "https://github.com/fastwa/fastwa/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fastwa/fastwa.git",
    "directory": "packages/fastwa"
  },
  "license": "MIT",
  "author": "Natan Rodrigues",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "**/*.js",
    "**/*.d.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "iterare": "1.2.1",
    "tslib": "2.4.1"
  },
  "peerDependencies": {
    "class-transformer": "*",
    "class-validator": "*",
    "reflect-metadata": "^0.1.13 || ^0.2.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
