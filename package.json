{
  "name": "@fastwa/core",
  "author": "Natan Rodrigues",
  "description": "Lightweight and powerfull framework",
  "license": "MIT",
  "version": "1.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/fastwa/fastwa"
  },
  "scripts": {
    "format": "prettier '**/*.ts' --ignore-path .prettierignore --write",
    "prebuild": "node scripts/clean.js",
    "start:dev": "ts-node-dev --ignore-watch node_modules --respawn --rs sample/01-stickers/src/main.ts",
    "build": "tsc -b -v packages",
    "publish": "npm run prebuild && npm run build && lerna publish --force-publish --exact -m \"chore(@fastwa) publish %s release\""
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "pino": "^8.7.0",
    "qrcode-terminal": "^0.12.0",
    "reflect-metadata": "^0.1.13",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "util": "^0.12.5"
  },
  "devDependencies": {
    "@types/ws": "^8.5.9",
    "@typescript-eslint/eslint-plugin": "^5.43.0",
    "@typescript-eslint/parser": "^5.43.0",
    "eslint": "^8.28.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-import-resolver-typescript": "^3.5.2",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-prettier": "^4.2.1",
    "lerna": "^10.1.1",
    "prettier": "^2.8.8",
    "tsconfig-paths": "^4.0.0",
    "typescript": "^5.5.4"
  },
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "nx": {
      "undici": "^7.30.1"
    }
  }
}
